@{
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar Contraseña | BEINN</title>
    <meta name="description" content="BEINN - Restablecimiento de contraseña">

    <!-- Bootstrap 5.3 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/binn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/binn-auth.css" asp-append-version="true" />
</head>

<body class="binn-auth-page binn-auth-page--locked">
    <video autoplay muted loop id="video-bg" class="binn-auth-video">
        <source src="@cdn/video/Login_snier.mp4" type="video/mp4">
    </video>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="binn-auth-card" data-aos="zoom-in">
            <div class="text-center mb-4">
                <img src="@cdn/be-inn/iconos/logobeeinn.png" alt="BEINN" class="binn-auth-logo">
                <h4 class="binn-auth-title">Recuperar Contraseña</h4>
                <p class="binn-auth-subtitle">Ingresa tu correo electrónico para recibir instrucciones</p>
            </div>

            @if (ViewData["EsExitoso"] == null || !(bool)ViewData["EsExitoso"])
            {
                <form method="post" action="@Url.Action("ForgotPassword", "Acceso")">
                    <div class="mb-4">
                        <label for="Correo" class="form-label">Correo electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input id="Correo" type="email" name="Correo" class="form-control"
                                placeholder="ejemplo@correo.com" required>
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary">Enviar Instrucciones</button>
                    </div>

                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="alert alert-danger text-center">
                            <i class="bi bi-exclamation-circle me-2"></i>@ViewData["Mensaje"]
                        </div>
                    }

                    <div class="text-center mt-3">
                        <a href="@Url.Action("Login", "Acceso")" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-2"></i>Volver al inicio de sesión
                        </a>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-success text-center">
                    <i class="bi bi-check-circle-fill me-2"></i>@ViewData["Mensaje"]
                </div>
                <div class="d-grid mt-4">
                    <a href="@Url.Action("Login", "Acceso")" class="btn btn-primary">
                        Volver al inicio de sesión
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>

