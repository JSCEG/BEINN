@using BEINN.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Be-Inn - Encuentra y publica espacios inteligentes";
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext?.Session.GetString("PerfilUsuario");
    PerfilUsuario perfilUsuario = null;

    if (!string.IsNullOrWhiteSpace(perfilUsuarioJson))
    {
        try
        {
            perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
        }
        catch
        {
            perfilUsuario = null;
        }
    }

    var usuarioAutenticado = perfilUsuario != null && !string.IsNullOrWhiteSpace(perfilUsuario.IdUsuario);
    var nombreUsuario = perfilUsuario?.Nombre ?? "Usuario BEINN";
    var rolUsuario = string.IsNullOrWhiteSpace(perfilUsuario?.Rol) ? "Miembro" : perfilUsuario.Rol;
    var nombrePartes = nombreUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var inicialesUsuario = string.Concat(nombrePartes.Take(2).Select(parte => char.ToUpperInvariant(parte[0])));

    if (string.IsNullOrWhiteSpace(inicialesUsuario))
    {
        inicialesUsuario = "B";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Be-Inn: renta estacionamientos, oficinas, coworks, casas y salones para eventos desde una sola plataforma." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/binn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/binn-public-landing.css" asp-append-version="true" />
</head>
<body class="binn-public-page">
    <header class="binn-public-topbar">
        <div class="binn-public-topbar__inner">
            <a class="binn-public-brand" href="@Url.Action("Login", "Acceso")">
                <span class="binn-public-brand__mark">
                    <img src="@cdn/be-inn/iconos/logobeeinn.png" alt="BEINN">
                </span>
                <span class="binn-public-brand__copy">
                    <strong>BEINN</strong>
                    <small>Espacios inteligentes</small>
                </span>
            </a>

            <div class="binn-public-topbar__actions">
                <button type="button" class="binn-public-link" data-open-offer-modal>
                    Hazte socio BE-INN
                </button>
                @if (usuarioAutenticado)
                {
                    <div class="binn-public-accountmenu" data-user-menu>
                        <button type="button" class="binn-public-accountmenu__trigger" data-user-menu-trigger aria-expanded="false">
                            <span class="binn-public-accountmenu__host">Panel activo</span>
                            <span class="binn-public-accountmenu__avatar">@inicialesUsuario</span>
                            <span class="binn-public-accountmenu__meta">
                                <strong>@nombreUsuario</strong>
                                <small>@rolUsuario</small>
                            </span>
                            <span class="binn-public-accountmenu__icon">
                                <i class="bi bi-list"></i>
                            </span>
                        </button>

                        <div class="binn-public-accountmenu__dropdown" data-user-menu-dropdown hidden>
                            <div class="binn-public-accountmenu__section">
                                <a href="@Url.Action("Index", "Home")">
                                    <i class="bi bi-grid"></i>
                                    <span>Ir a mi panel</span>
                                </a>
                                <a href="@Url.Action("MiPerfil", "Perfil", new { id = perfilUsuario?.IdUsuario })">
                                    <i class="bi bi-person-circle"></i>
                                    <span>Mi perfil</span>
                                </a>
                                <a href="@Url.Action("Dashboard", "Bitacora")">
                                    <i class="bi bi-clock-history"></i>
                                    <span>Actividad reciente</span>
                                </a>
                            </div>

                            <div class="binn-public-accountmenu__section">
                                <a href="@Url.Action("AllNotifications", "Usuarios", new { userId = perfilUsuario?.IdUsuario })">
                                    <i class="bi bi-bell"></i>
                                    <span>Notificaciones</span>
                                </a>
                                <a href="@Url.Action("Index", "Encuesta")">
                                    <i class="bi bi-ui-checks-grid"></i>
                                    <span>Encuestas y feedback</span>
                                </a>
                                <a href="@Url.Action("Index", "Ayuda")">
                                    <i class="bi bi-question-circle"></i>
                                    <span>Centro de ayuda</span>
                                </a>
                            </div>

                            <div class="binn-public-accountmenu__promo">
                                <div>
                                    <strong>Convierte tu espacio en ingreso</strong>
                                    <span>Publica estacionamientos, oficinas, coworks o salones.</span>
                                </div>
                                <button type="button" class="binn-public-accountmenu__promocta" data-open-offer-modal>
                                    Ofrecer ahora
                                </button>
                            </div>

                            <div class="binn-public-accountmenu__section">
                                <a class="binn-public-accountmenu__logout" href="@Url.Action("CerrarSesion", "Acceso")">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Cerrar sesión</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a class="binn-public-userpill" href="@Url.Action("AccesoComoInvitado", "Acceso")">
                        <i class="bi bi-compass"></i>
                        <span>Explorar sin cuenta</span>
                    </a>
                    <button type="button" class="binn-public-ghost-link binn-public-ghost-link--button" data-open-login-panel>
                        Iniciar sesión
                    </button>
                }
            </div>
        </div>
    </header>

    <main class="binn-public-main">
        <section class="binn-public-hero">
            <div class="binn-public-hero__backdrop"></div>
            <div class="binn-public-shell">
                <section class="binn-public-searchstage">
                    <div class="binn-public-searchstage__top">
                        <div class="binn-public-searchstage__intro">
                            <div class="binn-public-kicker">Plataforma corporativa</div>
                            <h1>Encuentra el espacio ideal para estacionarte, trabajar o reunirte.</h1>
                            <p>
                                Accede a la red más exclusiva de estacionamientos, oficinas privadas, coworks y
                                salones de eventos en un solo lugar.
                            </p>
                        </div>

                        <aside class="binn-public-searchstage__actions">
                            <button type="button" class="binn-public-topaction">
                                <i class="bi bi-stars"></i>
                                <span>Búsqueda con IA</span>
                            </button>
                            @if (usuarioAutenticado)
                            {
                                <a class="binn-public-topaction binn-public-topaction--solid" href="@Url.Action("Index", "Home")">
                                    <i class="bi bi-grid"></i>
                                    <span>Ir a mi panel</span>
                                </a>
                            }
                            else
                            {
                                <button type="button" class="binn-public-topaction binn-public-topaction--solid" data-open-login-modal>
                                    <i class="bi bi-person-circle"></i>
                                    <span>Iniciar sesión</span>
                                </button>
                            }
                        </aside>
                    </div>

                    <div class="binn-public-searchstage__chips" aria-label="Tipos de espacio">
                        <button type="button" class="binn-public-searchchip is-active" data-search-chip="estacionamientos">
                            <i class="bi bi-p-circle-fill"></i>
                            <span>Estacionamientos</span>
                        </button>
                        <button type="button" class="binn-public-searchchip" data-search-chip="oficinas">
                            <i class="bi bi-building"></i>
                            <span>Oficinas privadas</span>
                        </button>
                        <button type="button" class="binn-public-searchchip" data-search-chip="coworks">
                            <i class="bi bi-people"></i>
                            <span>Coworks</span>
                        </button>
                        <button type="button" class="binn-public-searchchip" data-search-chip="eventos">
                            <i class="bi bi-balloon-heart"></i>
                            <span>Salones y eventos</span>
                        </button>
                    </div>

                    <div class="binn-public-searchbar" id="inicio">
                        <div class="binn-public-searchbar__field">
                            <label>Destino</label>
                            <input type="text" id="landingDestination" placeholder="Ciudad, colonia o zona" />
                        </div>
                        <div class="binn-public-searchbar__field">
                            <label>Fechas</label>
                            <button type="button" class="binn-public-searchbar__select" id="landingDatesTrigger">
                                <span id="landingDatesLabel">Agregar fechas</span>
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <input type="hidden" id="landingDates" value="" />
                        </div>
                        <div class="binn-public-searchbar__field">
                            <label>Espacio</label>
                            <button type="button" class="binn-public-searchbar__select" id="landingTypeTrigger">
                                <span id="landingTypeLabel">Estacionamiento</span>
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <input type="hidden" id="landingType" value="Estacionamiento" />
                        </div>
                        <button type="button" class="binn-public-searchbar__cta">
                            <i class="bi bi-search"></i>
                            <span>Buscar</span>
                        </button>
                    </div>

                    <div class="binn-public-searchstage__suggestions">
                        <span>Sugerencias:</span>
                        <button type="button" class="binn-public-suggestion">Santa Fe</button>
                        <button type="button" class="binn-public-suggestion">Reforma</button>
                        <button type="button" class="binn-public-suggestion">Polanco</button>
                        <button type="button" class="binn-public-suggestion">Insurgentes Sur</button>
                    </div>
                </section>

                <div class="binn-public-hero__grid">
                    <aside class="binn-public-logincard" id="login-directo" @(usuarioAutenticado ? null : "hidden")>
                        @if (usuarioAutenticado)
                        {
                            <div class="binn-public-logincard__header">
                                <span class="binn-public-logincard__eyebrow">Sesión activa</span>
                                <h2>Hola, @nombreUsuario</h2>
                                <p>Tu cuenta ya está firmada. Puedes seguir explorando espacios o saltar directo a tu operación.</p>
                            </div>

                            <div class="binn-public-sessioncard">
                                <div class="binn-public-sessioncard__badge">@inicialesUsuario</div>
                                <div class="binn-public-sessioncard__content">
                                    <strong>@rolUsuario</strong>
                                    <span>Cuenta activa en BEINN Marketplace</span>
                                </div>
                            </div>

                            <div class="binn-public-sessioncard__actions">
                                <a class="binn-public-primarybtn binn-public-primarybtn--inline" href="@Url.Action("Index", "Home")">
                                    <i class="bi bi-grid"></i>
                                    <span>Abrir panel</span>
                                </a>
                                <a class="binn-public-secondarybtn" href="@Url.Action("MiPerfil", "Perfil", new { id = perfilUsuario?.IdUsuario })">
                                    <i class="bi bi-person"></i>
                                    <span>Ver perfil</span>
                                </a>
                            </div>

                            <div class="binn-public-logincard__footer">
                                <a href="@Url.Action("Dashboard", "Bitacora")">Ver actividad</a>
                                <a href="@Url.Action("Index", "Ayuda")">Centro de ayuda</a>
                                <a href="@Url.Action("CerrarSesion", "Acceso")">Cerrar sesión</a>
                            </div>
                        }
                        }
                    </aside>
                </div>
            </div>
        </section>

        <section class="binn-public-section">
            <div class="binn-public-shell">
                <div class="binn-public-section__heading">
                    <div>
                        <span class="binn-public-kicker">Disponibles ahora</span>
                        <h2>Espacios listos para reservar</h2>
                    </div>
                    <a href="@Url.Action("AccesoComoInvitado", "Acceso")">Ver inventario completo</a>
                </div>

                <div class="binn-public-cardrow">
                    <article class="binn-space-card">
                        <div class="binn-space-card__media">
                            <img src="https://images.unsplash.com/photo-1506521781263-d8422e82f27a?w=900&h=700&fit=crop" alt="Estacionamiento corporativo" />
                            <span class="binn-space-card__favorite-badge">Favorito entre huéspedes</span>
                            <button type="button" class="binn-space-card__favorite" aria-label="Guardar en favoritos">
                                <i class="bi bi-heart"></i>
                            </button>
                            <span class="binn-space-card__tag">Estacionamiento</span>
                        </div>
                        <div class="binn-space-card__body">
                            <strong>Estacionamiento corporativo Reforma</strong>
                            <div class="binn-space-card__submeta">20-22 mar</div>
                            <p>Acceso 24/7 y videovigilancia.</p>
                            <div class="binn-space-card__meta">
                                <span>$95 MXN por hora</span>
                                <b><i class="bi bi-star-fill"></i> 4.9</b>
                            </div>
                        </div>
                    </article>

                    <article class="binn-space-card">
                        <div class="binn-space-card__media">
                            <img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=900&h=700&fit=crop" alt="Oficina privada" />
                            <span class="binn-space-card__favorite-badge">Favorito entre huéspedes</span>
                            <button type="button" class="binn-space-card__favorite" aria-label="Guardar en favoritos">
                                <i class="bi bi-heart"></i>
                            </button>
                            <span class="binn-space-card__tag">Oficina</span>
                        </div>
                        <div class="binn-space-card__body">
                            <strong>Oficina privada Polanco</strong>
                            <div class="binn-space-card__submeta">17-19 abr</div>
                            <p>Internet, sala de juntas y recepción.</p>
                            <div class="binn-space-card__meta">
                                <span>$890 MXN por día</span>
                                <b><i class="bi bi-star-fill"></i> 4.8</b>
                            </div>
                        </div>
                    </article>

                    <article class="binn-space-card">
                        <div class="binn-space-card__media">
                            <img src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=900&h=700&fit=crop" alt="Cowork flexible" />
                            <span class="binn-space-card__favorite-badge">Favorito entre huéspedes</span>
                            <button type="button" class="binn-space-card__favorite" aria-label="Guardar en favoritos">
                                <i class="bi bi-heart"></i>
                            </button>
                            <span class="binn-space-card__tag">Cowork</span>
                        </div>
                        <div class="binn-space-card__body">
                            <strong>Cowork flexible Santa Fe</strong>
                            <div class="binn-space-card__submeta">24-26 abr</div>
                            <p>Cabinas privadas y café incluido.</p>
                            <div class="binn-space-card__meta">
                                <span>$280 MXN por jornada</span>
                                <b><i class="bi bi-star-fill"></i> 4.7</b>
                            </div>
                        </div>
                    </article>

                    <article class="binn-space-card">
                        <div class="binn-space-card__media">
                            <img src="https://images.unsplash.com/photo-1519167758481-83f550bb49b3?w=900&h=700&fit=crop" alt="Salón para eventos" />
                            <span class="binn-space-card__favorite-badge">Favorito entre huéspedes</span>
                            <button type="button" class="binn-space-card__favorite" aria-label="Guardar en favoritos">
                                <i class="bi bi-heart"></i>
                            </button>
                            <span class="binn-space-card__tag">Evento</span>
                        </div>
                        <div class="binn-space-card__body">
                            <strong>Salón boutique para eventos</strong>
                            <div class="binn-space-card__submeta">10-12 may</div>
                            <p>Talleres, presentaciones y celebraciones.</p>
                            <div class="binn-space-card__meta">
                                <span>$4,800 MXN por evento</span>
                                <b><i class="bi bi-star-fill"></i> 4.9</b>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="binn-public-section binn-public-section--soft">
            <div class="binn-public-shell">
                <div class="binn-public-section__heading">
                    <div>
                        <span class="binn-public-kicker">Para propietarios</span>
                        <h2>Monetiza tus espacios sin fricción</h2>
                    </div>
                </div>

                <div class="binn-public-offergrid">
                    <article class="binn-offer-card">
                        <i class="bi bi-p-circle"></i>
                        <strong>Estacionamientos</strong>
                        <p>Renta cajones por hora, jornada o mensualidad en zonas de alta demanda.</p>
                    </article>
                    <article class="binn-offer-card">
                        <i class="bi bi-building"></i>
                        <strong>Oficinas y coworks</strong>
                        <p>Publica oficinas privadas, salas de juntas o espacios híbridos por día o por bloque.</p>
                    </article>
                    <article class="binn-offer-card">
                        <i class="bi bi-calendar-event"></i>
                        <strong>Salones y eventos</strong>
                        <p>Gestiona reservas, disponibilidad y contacto comercial desde una sola operación.</p>
                    </article>
                    <article class="binn-offer-card">
                        <i class="bi bi-house-door"></i>
                        <strong>Casas y espacios especiales</strong>
                        <p>Activa propiedades, rooftops o locaciones temporales para renta flexible.</p>
                    </article>
                </div>
            </div>
        </section>
    </main>

    <div class="binn-offer-modal" id="offerModal" aria-hidden="true">
        <div class="binn-offer-modal__backdrop" data-close-offer-modal></div>
        <div class="binn-offer-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="offerModalTitle">
            <button type="button" class="binn-offer-modal__close" data-close-offer-modal aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="binn-offer-modal__head">
                <h3 id="offerModalTitle">¿Qué quieres ofrecer en BEINN?</h3>
                <p>Selecciona el tipo de espacio que deseas publicar para continuar con tu alta.</p>
            </div>
            <div class="binn-offer-modal__options">
                <button type="button" class="binn-offer-option is-selected" data-offer-type="estacionamiento">
                    <i class="bi bi-p-circle"></i>
                    <strong>Estacionamiento</strong>
                    <span>Cajón, pensión o lote privado</span>
                </button>
                <button type="button" class="binn-offer-option" data-offer-type="oficina">
                    <i class="bi bi-building"></i>
                    <strong>Oficina o cowork</strong>
                    <span>Privada, compartida o sala de juntas</span>
                </button>
                <button type="button" class="binn-offer-option" data-offer-type="evento">
                    <i class="bi bi-calendar-event"></i>
                    <strong>Salón o evento</strong>
                    <span>Talleres, reuniones o celebraciones</span>
                </button>
                <button type="button" class="binn-offer-option" data-offer-type="especial">
                    <i class="bi bi-house-door"></i>
                    <strong>Casa o espacio especial</strong>
                    <span>Propiedades flexibles y locaciones</span>
                </button>
            </div>
            <div class="binn-offer-modal__footer">
                <p id="offerSelectedLabel">Seleccionado: Estacionamiento</p>
                <a class="binn-public-primarybtn binn-public-primarybtn--inline" id="offerNextBtn" href="@Url.Action("Registro", "Acceso")">
                    <i class="bi bi-arrow-right"></i>
                    <span>Continuar</span>
                </a>
            </div>
        </div>
    </div>

    <div class="binn-date-modal" id="dateModal" aria-hidden="true">
        <div class="binn-date-modal__backdrop" data-close-date-modal></div>
        <div class="binn-date-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="dateModalTitle">
            <button type="button" class="binn-date-modal__close" data-close-date-modal aria-label="Cerrar calendario">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="binn-date-modal__head">
                <h3 id="dateModalTitle">Selecciona tu intervalo</h3>
                <p>Elige fecha de inicio y fin para filtrar espacios disponibles.</p>
            </div>
            <div class="binn-date-modal__summary">
                <div>
                    <span>Entrada</span>
                    <strong id="dateRangeStartLabel">Sin fecha</strong>
                </div>
                <div>
                    <span>Salida</span>
                    <strong id="dateRangeEndLabel">Sin fecha</strong>
                </div>
                <div>
                    <span>Noches</span>
                    <strong id="dateRangeNightsLabel">0</strong>
                </div>
            </div>
            <div class="binn-date-modal__months" id="dateMonths"></div>
            <div class="binn-date-modal__presets">
                <button type="button" class="binn-date-preset" data-range-days="1">+ 1 día</button>
                <button type="button" class="binn-date-preset" data-range-days="2">+ 2 días</button>
                <button type="button" class="binn-date-preset" data-range-days="3">+ 3 días</button>
                <button type="button" class="binn-date-preset" data-range-days="7">+ 7 días</button>
                <button type="button" class="binn-date-preset" data-range-days="14">+ 14 días</button>
            </div>
            <div class="binn-date-modal__footer">
                <button type="button" class="binn-public-secondarybtn" data-clear-date-range>Limpiar</button>
                <button type="button" class="binn-public-primarybtn binn-public-primarybtn--inline" data-apply-date-range>
                    <i class="bi bi-check2"></i>
                    <span>Aplicar fechas</span>
                </button>
            </div>
        </div>
    </div>

    @if (!usuarioAutenticado)
    {
        <div class="binn-login-modal" id="loginModal" aria-hidden="true">
            <div class="binn-login-modal__backdrop" data-close-login-modal></div>
            <div class="binn-login-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="loginModalTitle">
                <button type="button" class="binn-login-modal__close" data-close-login-modal aria-label="Cerrar acceso">
                    <i class="bi bi-x-lg"></i>
                </button>

                <div class="binn-public-logincard">
                    <div class="binn-public-logincard__header">
                        <span class="binn-public-logincard__eyebrow">Acceso directo</span>
                        <h2 id="loginModalTitle">Entra a BEINN</h2>
                        <p>Busca, administra o publica espacios sin salir de esta página.</p>
                    </div>

                    <div class="binn-public-social">
                        <form asp-controller="Acceso" asp-action="LoginGoogle" method="post" class="binn-public-social__item">
                            <button type="submit" class="btn binn-public-socialbtn binn-public-socialbtn--google">
                                <i class="bi bi-google"></i>
                                <span>Continuar con Google</span>
                            </button>
                        </form>

                        <form asp-controller="Acceso" asp-action="LoginFacebook" method="post" class="binn-public-social__item">
                            <button type="submit" class="btn binn-public-socialbtn binn-public-socialbtn--facebook">
                                <i class="bi bi-facebook"></i>
                                <span>Continuar con Facebook</span>
                            </button>
                        </form>
                    </div>

                    <div class="binn-public-divider"><span>o entra con tu cuenta</span></div>

                    <form id="loginForm" action="@Url.Action("Login", "Acceso")" method="post" class="binn-public-form">
                        <div class="binn-public-field">
                            <label for="Correo">Correo o RFC</label>
                            <div class="binn-public-inputwrap">
                                <i class="bi bi-person"></i>
                                <input type="text" id="Correo" name="Correo" placeholder="correo@empresa.com o RFC" required />
                            </div>
                        </div>

                        <div class="binn-public-field">
                            <label for="claveInput">Contraseña</label>
                            <div class="binn-public-inputwrap">
                                <i class="bi bi-lock"></i>
                                <input type="password" id="claveInput" name="Clave" placeholder="Tu contraseña" required />
                                <button type="button" class="binn-public-eye" onclick="togglePassword()" aria-label="Mostrar u ocultar contraseña">
                                    <i class="bi bi-eye-fill" id="iconoClave"></i>
                                </button>
                            </div>
                        </div>

                        @if (ViewData["Mensaje"] != null)
                        {
                            <div class="binn-public-alert binn-public-alert--error">
                                <i class="bi bi-exclamation-circle"></i>
                                <span>@ViewData["Mensaje"]</span>
                            </div>
                        }

                        <button type="submit" id="btnAcceso" class="binn-public-primarybtn">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Iniciar sesión</span>
                        </button>
                    </form>

                    <div class="binn-public-logincard__footer">
                        <a href="@Url.Action("ForgotPassword", "Acceso")">¿Olvidaste tu contraseña?</a>
                        <a href="@Url.Action("Registro", "Acceso")">Crear cuenta</a>
                        <a href="@Url.Action("AccesoComoInvitado", "Acceso")">Consulta pública</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.urlAccesoInvitado = '@Url.Action("AccesoComoInvitado", "Acceso")';
        window.urlLogin = '@Url.Action("Login", "Acceso")';
        window.urlRegistro = '@Url.Action("Registro", "Acceso")';
    </script>
    <script src="~/js/binn-public-landing.js" asp-append-version="true"></script>
</body>
</html>
