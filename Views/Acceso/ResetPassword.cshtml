@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva Contraseña | BEINN</title>
    <meta name="description" content="BEINN - Restablecimiento de contraseña">

    <!-- Bootstrap 5.3 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/binn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/binn-auth.css" asp-append-version="true" />
</head>

<body class="binn-auth-page binn-auth-page--reset">
    <video autoplay muted loop id="video-bg" class="binn-auth-video">
        <source src="https://cdn.sassoapps.com/video/Login_snier.mp4" type="video/mp4">
    </video>
      
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="binn-auth-card binn-auth-card--scrollable" data-aos="zoom-in">
            <div class="text-center mb-4">
                <img src="https://cdn.sassoapps.com/be-inn/iconos/logobeeinn.png" class="binn-auth-logo" alt="BEINN">
                <h4 class="binn-auth-title"><strong>Restablece tu contraseña</strong></h4>
                <p class="binn-auth-subtitle">Ingresa tu nueva contraseña</p>
            </div>
                @if (ViewData["EsExitoso"] == null || !(bool)ViewData["EsExitoso"])
                {
                    <!-- Mostrar formulario de restablecimiento de contraseña -->
                    <form action="@Url.Action("ResetPassword", "Acceso")" method="post">
                        
                        <div class="mb-4">
                            <label for="Token" class="form-label">Token</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                                <input id="Token" type="text" name="Token" class="form-control" value="@ViewData["Token"]" readonly>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="Clave" class="form-label">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input id="Clave" type="password" name="Clave" class="form-control" placeholder="Ingrese su Nueva contraseña" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="ConfirmarClave" class="form-label">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                <input id="ConfirmarClave" type="password" name="ConfirmarClave" class="form-control" placeholder="Confirme su contraseña" required>
                            </div>
                        </div>

                        @if (ViewData["Mensaje"] != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                @ViewData["Mensaje"]
                            </div>
                        }

                        <div class="d-grid mb-3">
                            <button type="submit" name="button" class="btn btn-primary">Restablecer contraseña</button>
                        </div>
                    </form>

                }

                else
                {
                    <!-- Mostrar mensaje de éxito y enlace de retorno -->

                    <div class="container">
                        <div class="row">
                            <div class="col alert alert-success text-center" role="alert">
                                    @ViewData["Mensaje"]
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                <center>
                                    <div class="text-center mt-3">
                                        <a href="@Url.Action("Login", "Acceso")" class="text-decoration-none">
                                            <i class="bi bi-arrow-left me-2"></i>Volver al inicio de sesión
                                        </a>
                                    </div>
                                </center>
                            </div>
                        </div>
                    </div>

                }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

