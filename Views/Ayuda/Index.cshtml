@model BEINN.Models.AyudaViewModel
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using BEINN.Models

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["IDUsuario"] = perfilUsuario.IdUsuario;
    ViewData["Title"] = Model.PageTitle;

    var header = new HeaderViewModel
    {
        Title = Model.PageTitle,
        IconPath = "ayuda.png",
        Description = Model.IntroDescription,
        Section = "Soporte",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = Model.PageTitle,
            description = "Centro de ayuda y soporte operativo de BEINN.",
            functionality = "Concentra guías, material de consulta, ubicación y canales de soporte.",
            stage = "Operación",
            roles = new[] {
                new { icon = "headset", text = "Usuarios BEINN: Consulta de ayuda y soporte" },
                new { icon = "life-ring", text = "Equipo de soporte: Atención y acompañamiento" }
            }
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container pt-3 p-md-3 p-lg-4">
    <h1 class="app-page-title">@Model.IntroTitle</h1>
    <p class="text-muted">@Model.IntroDescription</p>

    <div class="app-card app-card-accordion shadow-sm mb-4">
        <div class="app-card-header p-4 pb-2 border-0">
            <h4 class="app-card-title">¿Qué es BEINN?</h4>
        </div>
        <div class="app-card-body p-4 pt-0">
            <p>BEINN concentra el acceso a módulos, soporte operativo y servicios digitales para usuarios internos y clientes.</p>
            <video width="100%" height="auto" controls>
                <source src="@Model.PresentationVideoPath" type="video/mp4">
                Tu navegador no soporta este video.
            </video>
        </div>
    </div>

    @if (perfilUsuario.Rol != "0")
    {
        <div class="app-card app-card-accordion shadow-sm mb-4">
            <div class="app-card-header p-4 pb-2 border-0">
                <h4 class="app-card-title">Guías internas</h4>
            </div>
            <div class="app-card-body p-4 pt-0 d-grid gap-4">
                @if (perfilUsuario.Mercado_ID == "1" || perfilUsuario.Rol == "1")
                {
                    <iframe allowfullscreen scrolling="no" class="fp-iframe" src="@Model.ManualElectricidadUrl" style="width: 100%; height: 400px;"></iframe>
                }
                @if (perfilUsuario.Mercado_ID == "2" || perfilUsuario.Rol == "1")
                {
                    <iframe allowfullscreen scrolling="no" class="fp-iframe" src="@Model.ManualHidrocarburosUrl" style="width: 100%; height: 400px;"></iframe>
                }
            </div>
        </div>
    }

    <div class="app-card app-card-accordion shadow-sm mb-4">
        <div class="row g-0">
            <div class="col-md-6">
                <div class="app-card-header p-3 border-bottom-0">
                    <div class="row align-items-center gx-3">
                        <div class="col-auto">
                            <div class="app-icon-holder icon-holder-mono">
                                <i class="bi bi-headset" style="font-size: 2rem;"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h4 class="app-card-title">Soporte</h4>
                        </div>
                    </div>
                </div>
                <div class="app-card-body px-4 pb-4">
                    <div class="intro mb-3"><strong>Directorio y contacto:</strong><br>
                        Consulta el <a href="@Model.SupportDirectoryUrl" target="_blank">directorio</a> oficial para más información.
                    </div>
                    <ul class="list-unstyled">
                        <li><strong>Dirección:</strong> @Model.SupportAddress</li>
                        <li><strong>Teléfono:</strong> @Model.SupportPhone</li>
                        <li><strong>Email:</strong> <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a></li>
                    </ul>
                    <div class="mt-3">
                        <a class="btn btn-primary" asp-controller="Chat" asp-action="Asistente">Abrir asistente</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="app-card-header p-3 border-bottom-0">
                    <div id="mapi" style="height:400px; width:100%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var map = L.map('mapi').setView([19.3635996, -99.1904745], 17);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);
        var marker = L.marker([19.3635996, -99.1904745]).addTo(map);
        marker.bindPopup("<strong>BEINN</strong><br>Soporte y atención").openPopup();
    </script>
}
