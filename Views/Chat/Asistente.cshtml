@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using BEINN.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);

    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["Title"] = "Asistente";

    var header = new HeaderViewModel
    {
        Title = "Asistente",
        IconPath = "chat.png",
        Description = "Asistente conversacional para orientación, reservas y soporte dentro de BEINN.",
        Section = "Soporte",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Asistente",
            description = "Interfaz conversacional para consultas operativas y soporte de usuarios en BEINN.",
            functionality = "Recibe preguntas abiertas y responde con apoyo contextual del sistema.",
            stage = "Piloto",
            roles = new[] {
                new { icon = "robot", text = "Usuarios BEINN: Consultas y asistencia" },
                new { icon = "headset", text = "Soporte: Canal complementario de atención" }
            }
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container">
    <div class="app-card p-4 p-lg-5">
        <h2 class="fw-bold subtitulo mb-3">Asistente BEINN</h2>
        <p class="text-muted mb-4">Haz una pregunta sobre el uso de la plataforma o el flujo operativo que necesitas resolver.</p>
        <form asp-action="Ask" method="post">
            <div class="form-group mb-4">
                <label for="prompt" class="form-label">Tu pregunta</label>
                <input type="text" class="form-control form-control-lg" id="prompt" name="prompt" placeholder="Escribe aquí tu pregunta..." required>
            </div>

            <button type="submit" class="btn btn-primary">Preguntar</button>
        </form>

        @if (Model != null)
        {
            <div class="alert alert-info pt-3 mt-4" role="alert">
                <p class="fw-semibold mb-2">Respuesta del asistente</p>
                <p class="mb-0">@Model</p>
            </div>
        }
    </div>
</div>
