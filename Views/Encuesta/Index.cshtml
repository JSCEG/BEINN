@model BEINN.Models.Encuesta
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using BEINN.Models

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["IDUsuario"] = perfilUsuario.IdUsuario;
    ViewData["Title"] = "Encuesta";

    var header = new HeaderViewModel
    {
        Title = "Encuesta",
        IconPath = "analisis.png",
        Description = "Recopila satisfacción, hallazgos y oportunidades de mejora de la experiencia BEINN.",
        Section = "Soporte",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Encuesta",
            description = "Módulo de retroalimentación para medir la experiencia y satisfacción en BEINN.",
            functionality = "Permite capturar comentarios, utilidad percibida y nivel de satisfacción del usuario.",
            stage = "Operación",
            roles = new[] {
                new { icon = "chart-line", text = "Administración BEINN: Seguimiento de satisfacción" },
                new { icon = "comments", text = "Usuarios: Envío de comentarios y experiencia" }
            }
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container">
    <h3 class="subtitulo">Nos interesa conocer tu experiencia con BEINN</h3>
    <br>

    <div asp-validation-summary="All" class="text-danger"></div>
    <form id="Encuesta" asp-controller="Encuesta" asp-action="Enviar" method="post" class="app-card p-4 p-lg-5">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label" asp-for="Nombre">Nombre</label>
            <input type="text" class="form-control" asp-for="Nombre" required>
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Correo">Correo</label>
            <input type="email" class="form-control" asp-for="Correo" required>
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-check-label">¿Encontraste la información que buscabas?</label>
            <div>
                <input type="radio" class="form-check-input" asp-for="EncontroInformacion" value="true" required> Sí
                <input type="radio" class="form-check-input" asp-for="EncontroInformacion" value="false"> No
            </div>
        </div>

        <div class="mb-3">
            <label class="form-check-label">¿Te fue de utilidad?</label>
            <div>
                <input type="radio" class="form-check-input" asp-for="FueUtil" value="true" required> Sí
                <input type="radio" class="form-check-input" asp-for="FueUtil" value="false"> No
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="InformacionBuscada">¿Qué buscaste?</label>
            <textarea class="form-control" asp-for="InformacionBuscada" rows="3" style="height: 150px;" required></textarea>
            <span asp-validation-for="InformacionBuscada" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">¿Cómo calificas tu experiencia?</label>
            <select class="form-select" asp-for="CalificacionExperiencia">
                <option value="Muy satisfecho">Muy satisfecho</option>
                <option value="Bastante satisfecho">Bastante satisfecho</option>
                <option value="Normal">Normal</option>
                <option value="Un poco insatisfecho">Un poco insatisfecho</option>
                <option value="Muy insatisfecho">Muy insatisfecho</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-check-label">¿Quieres agregar un comentario?</label>
            <div>
                <input type="radio" class="form-check-input" asp-for="AgregarComentario" value="true" required> Sí
                <input type="radio" class="form-check-input" asp-for="AgregarComentario" value="false"> No
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="ComentarioAdicional">Comentario adicional</label>
            <textarea class="form-control" asp-for="ComentarioAdicional" rows="3" style="height:150px;"></textarea>
            <span asp-validation-for="ComentarioAdicional" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <input type="submit" class="btn btn-primary" value="Enviar">
        </div>
    </form>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#ComentarioAdicional').prop('disabled', true);

            $('input[type=radio][name=AgregarComentario]').change(function () {
                const enabled = this.value === 'true';
                $('#ComentarioAdicional').prop('disabled', !enabled);
                $('#ComentarioAdicional').prop('required', enabled);
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
