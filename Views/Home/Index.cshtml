@model BEINN.Models.HomeViewModel
@using BEINN.Models
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "BEINN";

    var perfilJson = HttpContextAccessor.HttpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;

    var header = new HeaderViewModel
    {
        Title = ViewData["Title"]?.ToString(),
        IconPath = "sistema.png",
        Description = "Centro de operación para accesos, módulos y seguimiento diario de la plataforma BEINN.",
        Section = "Inicio",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Centro de trabajo BEINN",
            description = "Vista principal para retomar actividad, acceder a módulos clave y ubicar rápidamente las áreas activas de la plataforma.",
            functionality = "Muestra accesos rápidos, actividad reciente, estado del workspace y accesos de soporte.",
            stage = "Operación",
            roles = new[] {
                new { icon = "user", text = "Usuarios internos: navegan, consultan y retoman actividad reciente" },
                new { icon = "user-shield", text = "Administradores: gestionan usuarios, secciones, bitácora y soporte" }
            },
            order = new { step = 0, description = "Entrada principal al núcleo operativo de BEINN" },
            manualUrl = "/Ayuda"
        })
    };

    var idUsuario = Convert.ToInt32(ViewData["IDUsuario"]);
    var rolUsuario = perfilUsuario?.Rol ?? "Sin asignar";
    var nombreUsuario = perfilUsuario?.Nombre ?? "Usuario";
    var mercadoUsuario = perfilUsuario?.Mercado_ID ?? "Todos";
    var esConsultaPublica = (rolUsuario == "10" || nombreUsuario.Contains("consult", StringComparison.OrdinalIgnoreCase));

    var secciones = Model.Secciones ?? new List<SeccionSistema>();
    var modulosVisibles = secciones
        .SelectMany(s => s.Modulos.Select(m => new { Seccion = s, Modulo = m }))
        .ToList();
    var modulosDestacados = modulosVisibles.Take(6).ToList();
    var totalSecciones = secciones.Count;
    var totalModulos = modulosVisibles.Count;
    var totalSubvistas = modulosVisibles.Sum(x => x.Modulo.Vistas?.Count ?? 0);
    var saludo = esConsultaPublica ? "Bienvenido a BEINN" : $"Hola, {nombreUsuario}";
}

@await Html.PartialAsync("_ViewHeader", header)

<section class="inner-home-page">
    <section class="inner-home-hero app-card" data-aos="fade-up">
        <div class="inner-home-hero__main">
            <div class="inner-home-hero__eyebrow">Workspace diario</div>
            <h1 class="inner-home-hero__title">@saludo</h1>
            <p class="inner-home-hero__copy">
                Accede a tus módulos, retoma vistas recientes y mantén el control del entorno desde una sola portada.
            </p>

            <div class="inner-home-tabs" role="list" aria-label="Estados del portal">
                <span class="inner-home-tab is-active"><i class="bi bi-grid"></i> Operación</span>
                <span class="inner-home-tab"><i class="bi bi-clock-history"></i> Seguimiento</span>
                <span class="inner-home-tab"><i class="bi bi-life-preserver"></i> Soporte</span>
            </div>

            <div class="inner-home-actions">
                <a class="btn btn-primary" asp-controller="Perfil" asp-action="MiPerfil" asp-route-id="@idUsuario">
                    <i class="bi bi-person-circle me-2"></i>Mi perfil
                </a>
                <a class="btn btn-outline-secondary" asp-controller="Chat" asp-action="Asistente">
                    <i class="bi bi-stars me-2"></i>Asistente
                </a>
            </div>
        </div>

        <aside class="inner-home-hero__stats">
            <div class="inner-home-stat inner-home-stat--primary">
                <span class="inner-home-stat__label">Rol</span>
                <strong>@rolUsuario</strong>
            </div>
            <div class="inner-home-stat inner-home-stat--mini">
                <span class="inner-home-stat__label">Mercado</span>
                <strong>@mercadoUsuario</strong>
            </div>
            <div class="inner-home-stat inner-home-stat--mini">
                <span class="inner-home-stat__label">Secciones</span>
                <strong>@totalSecciones activas</strong>
            </div>
            <div class="inner-home-stat inner-home-stat--accent">
                <span class="inner-home-stat__label">Inventario</span>
                <strong>@totalModulos módulos / @totalSubvistas subvistas</strong>
            </div>
        </aside>
    </section>

    <section class="inner-home-banner app-card" data-aos="fade-up" data-aos-delay="40">
        <div class="inner-home-banner__icon">
            <i class="bi bi-arrow-repeat"></i>
        </div>
        <div class="inner-home-banner__content">
            <strong>Continúa donde te quedaste</strong>
            <p id="home-activity-banner">Estamos consultando tu última actividad para proponerte el siguiente paso.</p>
        </div>
        <a asp-controller="Bitacora" asp-action="Dashboard" class="inner-home-banner__link">Ver monitoreo</a>
    </section>

    <section class="inner-home-filters" data-aos="fade-up" data-aos-delay="80">
        <div class="inner-home-filters__label">Secciones activas</div>
        <div class="inner-home-filter-chips">
            @foreach (var seccion in secciones)
            {
                <span class="inner-home-chip">@seccion.Titulo</span>
            }
        </div>
    </section>

    <section class="inner-home-grid">
        <article class="app-card inner-home-panel" data-aos="fade-up" data-aos-delay="120">
            <div class="inner-home-panel__header">
                <div>
                    <span class="inner-home-panel__kicker">Accesos destacados</span>
                    <h2 class="inner-home-panel__title">Tus módulos principales</h2>
                </div>
                <span class="inner-home-panel__hint">@totalModulos disponibles</span>
            </div>

            <div class="inner-home-card-grid">
                @if (modulosDestacados.Any())
                {
                    foreach (var item in modulosDestacados)
                    {
                        var modulo = item.Modulo;
                        var icono = modulo.EsExterno ? "bi-box-arrow-up-right" : "bi-grid-3x3-gap";
                        if (modulo.EsExterno)
                        {
                            <a class="inner-home-feature-card" href="@modulo.Action" target="_blank" rel="noopener noreferrer">
                                <div class="inner-home-feature-card__head">
                                    <span class="inner-home-feature-card__icon"><i class="bi @icono"></i></span>
                                    <span class="inner-home-feature-card__badge">@item.Seccion.Titulo</span>
                                </div>
                                <strong>@modulo.Title</strong>
                                <p>@(string.IsNullOrWhiteSpace(modulo.Desc) ? "Acceso configurado desde tu menú lateral." : modulo.Desc)</p>
                                <span class="inner-home-feature-card__cta">Abrir módulo</span>
                            </a>
                        }
                        else
                        {
                            <a class="inner-home-feature-card" asp-controller="@modulo.Controller" asp-action="@modulo.Action">
                                <div class="inner-home-feature-card__head">
                                    <span class="inner-home-feature-card__icon"><i class="bi @icono"></i></span>
                                    <span class="inner-home-feature-card__badge">@item.Seccion.Titulo</span>
                                </div>
                                <strong>@modulo.Title</strong>
                                <p>@(string.IsNullOrWhiteSpace(modulo.Desc) ? "Acceso configurado desde tu menú lateral." : modulo.Desc)</p>
                                <span class="inner-home-feature-card__cta">Abrir módulo</span>
                            </a>
                        }
                    }
                }
                else
                {
                    <div class="workspace-empty-state">No hay módulos activos disponibles para tu perfil.</div>
                }
            </div>
        </article>

        <article class="app-card inner-home-panel" data-aos="fade-up" data-aos-delay="160">
            <div class="inner-home-panel__header">
                <div>
                    <span class="inner-home-panel__kicker">Menú lateral</span>
                    <h2 class="inner-home-panel__title">Mapa del espacio de trabajo</h2>
                </div>
            </div>

            <div class="inner-home-section-list">
                @foreach (var seccion in secciones)
                {
                    var palabras = seccion.Titulo.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    var iniciales = string.Concat(palabras.Take(2).Select(p => p[0])).ToUpperInvariant();
                    <div class="inner-home-section-item">
                        <span class="inner-home-section-item__badge">@iniciales</span>
                        <div class="inner-home-section-item__body">
                            <strong>@seccion.Titulo</strong>
                            <small>@((seccion.Modulos?.Count ?? 0)) módulos activos</small>
                        </div>
                    </div>
                }
            </div>

            <div class="inner-home-support-stack">
                <a asp-controller="Ayuda" asp-action="Index" class="inner-home-inline-link">
                    <i class="bi bi-journal-text"></i>
                    <span>Centro de ayuda</span>
                </a>
                <a asp-controller="Encuesta" asp-action="Index" class="inner-home-inline-link">
                    <i class="bi bi-chat-square-heart"></i>
                    <span>Encuesta</span>
                </a>
                <a asp-controller="Bitacora" asp-action="Dashboard" class="inner-home-inline-link">
                    <i class="bi bi-activity"></i>
                    <span>Bitácora</span>
                </a>
            </div>
        </article>

        <article class="app-card inner-home-panel inner-home-panel--full" data-aos="fade-up" data-aos-delay="200">
            <div class="inner-home-panel__header">
                <div>
                    <span class="inner-home-panel__kicker">Actividad reciente</span>
                    <h2 class="inner-home-panel__title">Últimos visitados</h2>
                </div>
                <span class="inner-home-panel__hint">Hasta 6 accesos recientes</span>
            </div>

            <div id="home-recent-state" class="workspace-empty-state">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Cargando actividad reciente...
            </div>
            <div id="home-recent-list" class="inner-home-recent-grid d-none"></div>
        </article>
    </section>
</section>

@section Scripts {
    <script>
        function irA(elemento) {
            const controller = elemento.getAttribute('data-controller');
            const action = elemento.getAttribute('data-action');
            if (controller && action) {
                window.location.href = `/${controller}/${action}`;
            }
        }

        $(function () {
            const $banner = $('#home-activity-banner');
            const $state = $('#home-recent-state');
            const $list = $('#home-recent-list');

            $.ajax({
                url: '@Url.Action("GetUltimasAcciones", "Bitacora")',
                data: { top: 6 },
                dataType: 'json',
                success: acciones => {
                    if (!acciones || !acciones.length) {
                        $banner.text('Todavía no hay actividad registrada. Puedes comenzar desde los módulos destacados.');
                        $state.html('<i class="bi bi-clock-history me-2"></i>No hay actividad reciente todavía.');
                        return;
                    }

                    const primera = acciones[0];
                    $banner.text(`Última vista detectada: ${primera.pagina || 'Vista reciente'}${primera.fecha ? ' · ' + primera.fecha : ''}.`);

                    const html = acciones.map(a => {
                        const titulo = a.pagina || 'Vista reciente';
                        const fecha = a.fecha || 'Sin fecha registrada';
                        const controller = a.controller || '';
                        const action = a.action || '';
                        const badge = titulo.charAt(0).toUpperCase();
                        const image = `@Cdn.Url/img_snier/vistas/${titulo.toLowerCase().replace(/\\s+/g, '_')}.png`;

                        return `
                            <article class="inner-home-recent-card" tabindex="0" onclick="irA(this)" data-controller="${controller}" data-action="${action}">
                                <div class="inner-home-recent-card__media">
                                    <span class="inner-home-recent-card__badge">${badge}</span>
                                    <img src="${image}" alt="${titulo}" loading="lazy" onerror="this.style.display='none'">
                                </div>
                                <div class="inner-home-recent-card__body">
                                    <strong>${titulo}</strong>
                                    <small>${fecha}</small>
                                    <span class="inner-home-recent-card__cta">Abrir vista <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </article>`;
                    }).join('');

                    $state.addClass('d-none');
                    $list.html(html).removeClass('d-none');
                },
                error: () => {
                    $banner.text('No se pudo consultar la actividad reciente en este momento.');
                    $state.html('<i class="bi bi-exclamation-circle me-2"></i>No fue posible cargar la actividad reciente.');
                }
            });
        });
    </script>
}
