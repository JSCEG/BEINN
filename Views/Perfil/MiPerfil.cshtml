@model BEINN.Models.MiPerfilViewModel
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using BEINN.Models

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var perfilUsuarioJson = httpContext.Session.GetString("PerfilUsuario");
    var perfilUsuario = JsonConvert.DeserializeObject<PerfilUsuario>(perfilUsuarioJson);
    ViewData["NombreUsuario"] = perfilUsuario.Nombre;
    ViewData["RolUsuario"] = perfilUsuario.Rol;
    ViewData["MercadoUsuario"] = perfilUsuario.Mercado_ID;
    ViewData["IDUsuario"] = perfilUsuario.IdUsuario;
    ViewData["Title"] = "Mi Perfil";

    var header = new HeaderViewModel
    {
        Title = ViewData["Title"]?.ToString(),
        IconPath = "mexicoi.png",
        Description = "Consulta los datos de tu cuenta, valida tu estado actual y actualiza credenciales personales.",
        Section = "Perfil",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Mi Perfil",
            description = "Vista personal del usuario dentro de BEINN.",
            functionality = "Muestra información de cuenta, estado de sesión y acceso al cambio de contraseña.",
            stage = "Operación",
            roles = new[] {
                new { icon = "user", text = "Usuario autenticado: consulta sus datos y gestiona su acceso." }
            },
            order = new { step = 1, description = "Administración básica de la cuenta personal" },
            manualUrl = "/Ayuda"
        })
    };
}

@await Html.PartialAsync("_ViewHeader", header)

<div class="container mt-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Información de la cuenta</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre</label>
                            <input class="form-control" value="@Model.Nombre" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Correo</label>
                            <input class="form-control" value="@Model.Correo" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">RFC</label>
                            <input class="form-control" value="@Model.RFC" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cargo</label>
                            <input class="form-control" value="@Model.Cargo" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Unidad de adscripción</label>
                            <input class="form-control" value="@Model.UnidadDeAdscripcion" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Clave de empleado</label>
                            <input class="form-control" value="@Model.ClaveEmpleado" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Rol</label>
                            <input class="form-control" value="@Model.RolNombre" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mercado</label>
                            <input class="form-control" value="@Model.MercadoNombre" readonly />
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <a class="btn btn-primary" asp-controller="Usuarios" asp-action="Edit" asp-route-id="@Model.IdUsuario">Editar perfil</a>
                        <a class="btn btn-outline-secondary" asp-controller="Bitacora" asp-action="Dashboard">Ver actividad</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Estado</h5>
                    <p class="mb-2"><strong>Sesión activa:</strong> @(Model.SesionActiva ? "Sí" : "No")</p>
                    <p class="mb-0"><strong>Usuario vigente:</strong> @(Model.Vigente ? "Sí" : "No")</p>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title">Cambiar contraseña</h5>
                    <form id="cambio-contrasena-form" asp-controller="Acceso" asp-action="ResetPasswordUser" method="post">
                        <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />
                        <div class="mb-3">
                            <input type="password" name="Clave" class="form-control" placeholder="Nueva contraseña" required autocomplete="new-password" />
                        </div>
                        <div class="mb-3">
                            <input type="password" name="ConfirmarClave" class="form-control" placeholder="Confirmar contraseña" required autocomplete="new-password" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Actualizar contraseña</button>
                    </form>
                    <div id="mensaje-reset-password" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#cambio-contrasena-form").submit(function (event) {
            event.preventDefault();

            $.ajax({
                type: "POST",
                url: $(this).attr("action"),
                data: $(this).serialize(),
                success: function (response) {
                    $("#mensaje-reset-password").html("<div class='alert alert-success'>" + response + "</div>");
                },
                error: function (xhr, status, error) {
                    $("#mensaje-reset-password").html("<div class='alert alert-danger'>No se pudo actualizar la contraseña. " + error + "</div>");
                }
            });
        });
    </script>
}
